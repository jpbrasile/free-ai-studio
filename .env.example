# ============================================================
# FREE AI STUDIO — CONFIGURATION
# Ne mettez JAMAIS ce fichier .env réel sur GitHub.
# ============================================================

# --- SÉCURITÉ FINANCIÈRE ---
FREE_ONLY=true
ALLOW_PAID_MODELS=false
ALLOW_PAID_GPU=false
MAX_DAILY_COST=0

# ============================================================
# FREE TIER MANAGER — ROUTAGE AUTOMATIQUE
# ============================================================

# Clé locale entre Open WebUI et le manager.
# install.sh / install.ps1 la génère automatiquement si elle est vide.
FREE_TIER_MANAGER_KEY=

# Ordre de fallback transparent.
FREE_PROVIDER_ORDER=gemini,openrouter,groq

# OpenRouter est utilisé avec "openrouter/free" : route zéro coût.
OPENROUTER_FREE_MODEL=openrouter/free

# Modèles de fallback sur les plans gratuits des fournisseurs.
GROQ_FREE_MODEL=openai/gpt-oss-20b
# Gemini : Flash-Lite par défaut, la variante prévue pour l'usage quotidien.
# Le quota gratuit est compté par projet ET par modèle, et Google ne publie plus
# les chiffres : ils se lisent dans AI Studio (relevé du 11/09/2026). Quand le
# quota est atteint, le Studio affiche la limite que Google annonce dans son refus.
GEMINI_FREE_MODEL=gemini-3.5-flash-lite
# Free AI Max, deuxième choix du chat, pour les questions difficiles : ce modèle
# d'abord, puis Flash-Lite, puis les mêmes secours. Même clé Google, quota à part
# (compté par modèle) ; Free AI Auto n'y touche jamais.
GEMINI_MAX_MODEL=gemini-3.8-flash

ENABLE_OPENROUTER=true
ENABLE_GROQ=false
ENABLE_GEMINI=true
# false retire Free AI Max du chat. ENABLE_GEMINI=false coupe les deux modèles Gemini.
ENABLE_GEMINI_MAX=true

# true (défaut) = Gemini Free Tier est prioritaire, OpenRouter Free sert de fallback.
# Le Studio ne peut pas vérifier automatiquement le statut de facturation du compte
# Google/Groq : utilisez une clé/projet qui reste bien sur le Free Tier.
# Passez à false pour un mode ultra-strict limité aux routes explicitement zéro coût.
ALLOW_FREE_TIER_ACCOUNTS=true


# ============================================================
# BOOST OPENROUTER — DÉSACTIVÉ PAR DÉFAUT
# ============================================================

# Réserve logique qui ne doit pas être entamée par le Boost.
OPENROUTER_PROTECTED_RESERVE_USD=10

# Budget payant total autorisable par Free AI Studio.
OPENROUTER_BOOST_TOTAL_BUDGET_USD=5

# Plafond conseillé lors d'une activation ponctuelle.
OPENROUTER_BOOST_DEFAULT_CAP_USD=0.50
OPENROUTER_BOOST_MAX_SINGLE_USD=1.00

# Retour automatique au gratuit après cette durée.
OPENROUTER_BOOST_SESSION_MINUTES=60

# Le modèle Boost reste configurable. Le routeur automatique OpenRouter
# choisit un modèle adapté, mais son prix dépend du modèle réellement routé.
OPENROUTER_BOOST_MODEL=openrouter/auto


# --- OPEN WEBUI ---
# Généré automatiquement par install.sh / install.ps1 si vide.
WEBUI_SECRET_KEY=

# ============================================================
# FOURNISSEURS PRINCIPAUX
# ============================================================

# Google Gemini
# Créer une clé :
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq
# Créer une clé :
# https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter
# Créer une clé :
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# OPTIONNEL : uniquement pour afficher automatiquement le niveau de quota
# OpenRouter (50/jour ou 1000/jour après >= $10 de crédits achetés).
# L'API officielle /credits nécessite une Management Key.
# Ne pas confondre avec la clé d'inférence ci-dessus.
OPENROUTER_MANAGEMENT_KEY=

# ============================================================
# FOURNISSEURS OPTIONNELS
# ============================================================

# Hugging Face
# Créer un token :
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Cloudflare Workers AI
# Guide officiel :
# https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================
# OPEN WEBUI (l'interface de chat, http://localhost:3000)
# ============================================================

# Compte utilisateur dans Open WebUI. false = on entre directement, sans e-mail
# ni mot de passe : le port n'est ouvert que sur 127.0.0.1, donc uniquement depuis
# cet ordinateur. Mettez true si plusieurs personnes se partagent la machine —
# mais AVANT le tout premier démarrage : Open WebUI refuse de rebasculer une base
# qui contient déjà un compte.
WEBUI_AUTH=false

# Nom affiché et langue de départ de l'interface.
WEBUI_NAME=Free AI Studio
DEFAULT_LOCALE=fr

# Recherche web dans le chat. DuckDuckGo ne demande ni clé ni compte.
# ATTENTION : Open WebUI ne lit ces deux lignes qu'au TOUT PREMIER démarrage ;
# ensuite il ne consulte plus que sa propre base. C'est donc Free AI Studio qui
# pose le réglage, une seule fois, à son démarrage. Le fichier témoin
# config/open-webui-regle.json dit ce qui a été posé ; le supprimer et
# redémarrer refait la pose.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=duckduckgo

# « Arena Model » (tirage au sort entre les modèles, avec un vote) est retiré
# du chat une fois, au démarrage ; témoin config/open-webui-arena.json. Pour le
# remettre : Open WebUI, Admin, Settings, Evaluations.

# Modèle Google utilisé pour FABRIQUER une image (bouton « Image » du chat).
# La clé est celle du chat : rien de plus à saisir.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Dictée (le micro du chat). Le choix se fait sur la page d'accueil du Studio :
# « Groq si possible » (groq) : avec une clé Groq, votre voix part chez Groq
#   (whisper-large-v3, palier gratuit) ; sans clé, ou si Groq refuse, la
#   dictée se fait sur votre ordinateur, sans message d'erreur ;
# « Sur cet ordinateur » (local) : la voix ne quitte jamais le PC.
# DICTEE_MODE ne donne que le choix de départ.
# Le Whisper de l'ordinateur tourne sur le processeur, sans carte graphique.
# Mesuré le 15/09/2026 (4 cœurs, dictées de 4 à 7 s) : small, 0,7 à 0,9 s et
# 0,95 Gio de mémoire ; large-v3-turbo, un peu meilleur, 2,6 à 3 s et 2,6 Gio.
# Un changement ici prend effet au prochain démarrage du Studio.
DICTEE_MODE=groq
WHISPER_MODEL=small
# Second Whisper, celui qui NETTOIE /dialogue — il ne remplace pas le précédent,
# il vit à côté. Deux raisons : comparer un rendu au texte envoyé demande un
# modèle plus fin qu'une dictée, et un gros modèle qui prendrait la place du
# petit ferait attendre une minute à chaque dictée. « medium » choisi le
# 17/09/2026 : c'est celui avec lequel la réparation a été validée à l'oreille.
# Sur le processeur, comptez environ 63 s pour 147 s d'audio. Un modèle plus
# gros nettoierait peut-être mieux, mais ce n'est pas mesuré.
ALIGNEMENT_WHISPER_MODEL=medium
# Langue : « auto » (Whisper reconnaît la langue parlée ; sur l'ordinateur,
# l'une de DICTEE_LANGUES), ou un code (fr, en…) pour l'imposer. Imposée en
# français, une dictée en anglais revenait TRADUITE en français (15/09/2026).
DICTEE_LANGUE=auto
DICTEE_LANGUES=fr,en

# Lire à haute voix (le 🔊 sous chaque réponse du chat). Depuis le 15/09/2026,
# c'est le routeur qui lit, avec Piper, sur le processeur : sans clé, le texte
# ne quitte pas le PC. Depuis le 16/09/2026, une voix par langue, reconnue
# phrase par phrase : « siwis » en français, « norman » en anglais. Les deux
# voix (63 Mo chacune) se téléchargent une fois, au démarrage.
# Le réglage d'Open WebUI est posé une fois ;
# témoin config/open-webui-voix.json. Pour reprendre la voix du navigateur :
# Open WebUI, Panneau d'administration, Audio, moteur de synthèse vocale.

# ============================================================
# EXTENSIONS OPTIONNELLES
# ============================================================

# URL d'un serveur ComfyUI local ou distant.
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Exemple : URL d'un moteur Ollama local.
OLLAMA_BASE_URL=http://host.docker.internal:11434



# ============================================================
# SANDBOX / AGENT DE CODAGE
# ============================================================
# Générées automatiquement par install.sh / install.ps1.
SANDBOX_MANAGER_KEY=
SANDBOX_WORKER_KEY=
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_CODE_BYTES=500000
SANDBOX_MAX_OUTPUT_BYTES=200000
SANDBOX_MAX_ARTIFACT_BYTES=104857600

# Routage automatique : Modal -> Local -> Kaggle (jobs GPU seulement) -> Colab.
# Modal n'est utilisé que si vous l'activez ET fournissez vos tokens. Cela évite
# toute consommation cloud accidentelle lors d'une installation fraîche.
MODAL_ENABLED=false
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=free-ai-studio-sandbox
# Durée maximale du code utilisateur.
MODAL_JOB_TIMEOUT_SECONDS=300
# Filet de sécurité serveur : stoppe une Sandbox Modal inactive.
MODAL_IDLE_TIMEOUT_SECONDS=60
# Temps réservé au démarrage + collecte des artefacts avant le timeout absolu.
MODAL_CLEANUP_GRACE_SECONDS=60
MODAL_CPU=1.0
MODAL_MEMORY_MB=2048
MODAL_GPU_DEFAULT=T4

# ============================================================
# VIDÉO — la seule fonction qui loue une carte graphique
# ============================================================
# Il n'existe aucun service de fabrication de vidéo gratuit et hébergé
# (relevé de septembre 2026). Le Studio fait donc tourner un modèle ouvert
# (Wan 2.1 VACE 1,3 B, licence Apache 2.0) sur une machine louée à la minute.
#
# Modal, relevé du 11/09/2026 (modal.com/pricing, modal.com/docs/guide/billing,
# modal.com/docs/guide/budgets) : 30 $ de crédit par mois sur l'offre Starter,
# CARTE BANCAIRE EXIGÉE pour utiliser la plateforme, et au-delà du crédit Modal
# FACTURE, jusqu'à la limite de dépense du compte. Réglez-la au plus bas :
# https://modal.com/settings/usage
#
# Le Studio ne lit PAS votre compte Modal. MODAL_CREDIT_MENSUEL_USD est ce que
# VOUS déclarez ; la page /video l'affiche comme une déclaration, pas comme un fait.
#
# Le plafond ci-dessous est un refus AVANT de lancer, pas un constat après coup :
# si le pire cas d'un clip ferait dépasser, le clip n'est pas lancé du tout.
# Depuis le 19/09/2026 il est UNIQUE et partagé : la vidéo, la chanson, le
# dialogue et les travaux envoyés au Sandbox tirent tous dessus, et se voient
# les uns les autres. Il n'y a plus de « reste du Sandbox » non compté.
# UN SEUL plafond Modal depuis le 19/09/2026, partage par la video, la
# chanson, le dialogue ET le bac a sable -- qui depensait jusque-la sans
# etre compte par personne. Il remplace les trois anciens plafonds
# (VIDEO_ 20, CHANSON_ 5, DIALOGUE_ 5), dont la somme valait exactement le
# credit ci-dessous alors qu'aucun ne voyait les autres.
MODAL_BUDGET_USD_PAR_MOIS=30
# Part de ce plafond reservee au bac a sable : les demandes faites depuis
# les pages sont refusees avant de l'entamer. 0.5 = la moitie. Mettez 0
# pour laisser les pages aller jusqu'au bout du plafond.
MODAL_PART_RESERVEE_AUTONOME=0.5
MODAL_CREDIT_MENSUEL_USD=30

# Durée maximale d'un clip, garde-fou dur (secondes). Large, car le tout premier
# lancement télécharge le modèle ; les suivants le trouvent en cache.
VIDEO_TIMEOUT_SECONDS=2400

# Cartes demandées à Modal. L4 (24 Go) est la moins chère qui suffise ;
# A100 sert au modèle « soigné », environ six fois plus cher.
VIDEO_GPU_RAPIDE=L4
VIDEO_GPU_SOIGNE=A100
VIDEO_MEMORY_MB=16384

# Disque persistant Modal où le modèle est gardé d'un clip à l'autre.
# Modal offre 1 Tio de stockage : nos ~6 Go n'y coûtent rien.
VIDEO_MODAL_VOLUME=free-ai-studio-modeles

# ============================================================
# CHANSON — des paroles chantées par YuE2-3B (page /chanson du Sandbox)
# ============================================================
# Poids sous licence CC BY-NC 4.0 : usage NON COMMERCIAL. Même disque persistant
# que la vidéo (VIDEO_MODAL_VOLUME) ; environ 7 Go de plus.
#
# Plus de plafond à part : la chanson tire sur MODAL_BUDGET_USD_PAR_MOIS, comme
# les trois autres usages. Le compteur ajoute le processeur et la mémoire à la
# carte (prix relevés le 17/09/2026). Une chanson n'est lancée que si son pire
# cas (CHANSON_TIMEOUT_SECONDS de L4) tient encore sous ce qui reste aux
# demandes — c'est-à-dire hors la part réservée au Sandbox.
CHANSON_TIMEOUT_SECONDS=1800
# L4 : la moins chère des cartes qui calculent en bfloat16, que le pipeline
# officiel exige. Une carte T4 ferait passer par les correctifs non officiels.
CHANSON_GPU=L4
# La fiche du modèle demande 24 Go de mémoire vive à côté de la carte.
CHANSON_MEMORY_MB=24576
# Kaggle, gratuit : forme de machine demandée (exemple de la documentation du
# CLI Kaggle). D'après des sources non officielles relayées le 15/09/2026, la
# carte gratuite est une paire de T4 (30 h par semaine, compte vérifié par
# téléphone) et la L4 est réservée à certaines compétitions : ne pas mettre
# NvidiaL4. Délai large : tout se réinstalle et se retélécharge à chaque chanson
# (une minute de chanson a pris 6 minutes le 15/09/2026). Kaggle arrête le
# notebook lui-même à ce délai.
CHANSON_KAGGLE_MACHINE=NvidiaTeslaT4
CHANSON_KAGGLE_TIMEOUT_SECONDS=5400

# --- Dialogue à deux voix (/dialogue), FireRedTTS-2 -------------------------
# Plus de compteur étanche. Ce qui était écrit ici — « 5 + 20 + 5 = 30 $, soit
# exactement le crédit Modal ; les trois peuvent donc atteindre leur plafond le
# même mois » — décrivait le défaut sans le corriger. Un seul compteur depuis le
# 19/09/2026. La limite que vous réglez chez Modal reste la seule qui fasse foi :
# le Studio estime, Modal facture.
DIALOGUE_TIMEOUT_SECONDS=1800
# L4, comme la chanson. Relevé du 17/09/2026 en régime de croisière (image et
# poids de 12,6 Go déjà en cache) : environ 0,03 $ et 105 s pour un dialogue
# court. C'est un relevé unique, pas une moyenne.
DIALOGUE_GPU=L4
# Repris de la chanson, NON MESURÉ pour ce modèle : 12,6 Go de poids passent
# par la mémoire vive au chargement.
DIALOGUE_MEMORY_MB=24576
# Kaggle, gratuit : mesuré deux fois le 17/09/2026, et UNE SEULE T4 suffit
# (pic 12,95 Go sur 14,56 pour 147,5 s d'audio). Ne pas mettre NvidiaL4, la L4
# gratuite est réservée à certaines compétitions. Bien plus lent que Modal :
# 720 s de bout en bout pour le plus long dialogue mesuré, soit 3,35 fois la
# durée du son produit.
DIALOGUE_KAGGLE_MACHINE=NvidiaTeslaT4
DIALOGUE_KAGGLE_TIMEOUT_SECONDS=3600
# Nettoyage automatique du rendu. Ce modèle insère parfois des bouts de parole
# jamais demandés, parfois en anglais (mesuré : 5 intrusions en 147,5 s). Le
# Studio retranscrit le fichier, le compare au texte envoyé et retire ce qui
# n'y était pas. L'ORIGINAL RESTE TÉLÉCHARGEABLE. Ce délai couvre la
# transcription, qui tourne sur le processeur : environ 63 s pour 147 s d'audio.
# Sans FREE_TIER_MANAGER_KEY, le nettoyage n'a simplement pas lieu et le
# dialogue est livré tel quel.
DIALOGUE_NETTOYAGE_TIMEOUT_SECONDS=900

# Kaggle : fallback automatisable, avec VOS identifiants, sur VOTRE machine.
# L'accès direct (kaggle.com/code) reste toujours disponible.
KAGGLE_ENABLED=false
# Délai d'un travail Kaggle, en secondes. Kaggle arrête lui-même le notebook au
# bout de ce temps (option -t de « kaggle kernels push ») ; le Studio attend
# 15 minutes de plus, pour une éventuelle file d'attente, puis abandonne.
KAGGLE_JOB_TIMEOUT_SECONDS=3600
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KEY=

# true si ce Studio sert d'autres personnes que vous (hébergé, partagé).
# Coupe Kaggle automatique : les calculs des autres partiraient sur VOTRE compte
# Kaggle. Il est aussi coupé d'office si WEBUI_AUTH=true, si la page est ouverte
# par l'adresse réseau de la machine, ou derrière un proxy (docs/GPU_CLOUD.md).
STUDIO_HEBERGE=false

# L'adresse d'hôte sur laquelle les trois ports sont publiés. C'est la MÊME
# chaîne qui ouvre le port dans docker-compose.yml et que les services relisent
# au démarrage : elle ne peut donc pas mentir.
#
# Tant qu'elle vaut 127.0.0.1, le Studio n'est joignable que depuis cette
# machine, et les clés écrites en clair dans config/ sont les vôtres, chez vous.
# La changer (0.0.0.0, une adresse de réseau local…) expose ces clés : les deux
# services REFUSENT ALORS DE DÉMARRER, avec le motif dans leurs journaux.
# C'est voulu, et c'est sans interrupteur : décision du 19/09/2026,
# docs/PLAN-PLATEFORME.md §2.1 et §8 décision 3. Pour ouvrir le Studio à
# d'autres personnes, il faut d'abord que les clés cessent d'être en clair.
STUDIO_ADRESSE_PUBLIEE=127.0.0.1

# Colab : accès direct + handoff notebook. L'API officielle est bêta/allowlist.
COLAB_API_ENABLED=false

# ============================================================
# SERVICES OPTIONNELS — À IGNORER SI VOUS DÉBUTEZ
# ============================================================
HUGGINGFACE_TOKEN=
E2B_API_KEY=
DAYTONA_API_KEY=
FAL_KEY=
SEGMIND_API_KEY=
FIREWORKS_API_KEY=
