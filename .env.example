# ============================================================
# FREE AI STUDIO — CONFIGURATION
# Ne mettez JAMAIS ce fichier .env réel sur GitHub.
# ============================================================

# --- SÉCURITÉ FINANCIÈRE ---
FREE_ONLY=true
ALLOW_PAID_MODELS=false
ALLOW_PAID_GPU=false
MAX_DAILY_COST=0

# ============================================================
# FREE TIER MANAGER — ROUTAGE AUTOMATIQUE
# ============================================================

# Clé locale entre Open WebUI et le manager.
# install.sh / install.ps1 la génère automatiquement si elle est vide.
FREE_TIER_MANAGER_KEY=

# Ordre de fallback transparent.
FREE_PROVIDER_ORDER=gemini,openrouter,groq

# OpenRouter est utilisé avec "openrouter/free" : route zéro coût.
OPENROUTER_FREE_MODEL=openrouter/free

# Modèles de fallback sur les plans gratuits des fournisseurs.
GROQ_FREE_MODEL=openai/gpt-oss-20b
GEMINI_FREE_MODEL=gemini-3.8-flash

ENABLE_OPENROUTER=true
ENABLE_GROQ=false
ENABLE_GEMINI=true

# true (défaut) = Gemini Free Tier est prioritaire, OpenRouter Free sert de fallback.
# Le Studio ne peut pas vérifier automatiquement le statut de facturation du compte
# Google/Groq : utilisez une clé/projet qui reste bien sur le Free Tier.
# Passez à false pour un mode ultra-strict limité aux routes explicitement zéro coût.
ALLOW_FREE_TIER_ACCOUNTS=true


# ============================================================
# BOOST OPENROUTER — DÉSACTIVÉ PAR DÉFAUT
# ============================================================

# Réserve logique qui ne doit pas être entamée par le Boost.
OPENROUTER_PROTECTED_RESERVE_USD=10

# Budget payant total autorisable par Free AI Studio.
OPENROUTER_BOOST_TOTAL_BUDGET_USD=5

# Plafond conseillé lors d'une activation ponctuelle.
OPENROUTER_BOOST_DEFAULT_CAP_USD=0.50
OPENROUTER_BOOST_MAX_SINGLE_USD=1.00

# Retour automatique au gratuit après cette durée.
OPENROUTER_BOOST_SESSION_MINUTES=60

# Le modèle Boost reste configurable. Le routeur automatique OpenRouter
# choisit un modèle adapté, mais son prix dépend du modèle réellement routé.
OPENROUTER_BOOST_MODEL=openrouter/auto


# --- OPEN WEBUI ---
# Généré automatiquement par install.sh / install.ps1 si vide.
WEBUI_SECRET_KEY=

# ============================================================
# FOURNISSEURS PRINCIPAUX
# ============================================================

# Google Gemini
# Créer une clé :
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq
# Créer une clé :
# https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter
# Créer une clé :
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# OPTIONNEL : uniquement pour afficher automatiquement le niveau de quota
# OpenRouter (50/jour ou 1000/jour après >= $10 de crédits achetés).
# L'API officielle /credits nécessite une Management Key.
# Ne pas confondre avec la clé d'inférence ci-dessus.
OPENROUTER_MANAGEMENT_KEY=

# ============================================================
# FOURNISSEURS OPTIONNELS
# ============================================================

# Hugging Face
# Créer un token :
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Cloudflare Workers AI
# Guide officiel :
# https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================
# OPEN WEBUI (l'interface de chat, http://localhost:3000)
# ============================================================

# Compte utilisateur dans Open WebUI. false = on entre directement, sans e-mail
# ni mot de passe : le port n'est ouvert que sur 127.0.0.1, donc uniquement depuis
# cet ordinateur. Mettez true si plusieurs personnes se partagent la machine —
# mais AVANT le tout premier démarrage : Open WebUI refuse de rebasculer une base
# qui contient déjà un compte.
WEBUI_AUTH=false

# Nom affiché et langue de départ de l'interface.
WEBUI_NAME=Free AI Studio
DEFAULT_LOCALE=fr

# Recherche web dans le chat. DuckDuckGo ne demande ni clé ni compte.
# ATTENTION : Open WebUI ne lit ces deux lignes qu'au TOUT PREMIER démarrage ;
# ensuite il ne consulte plus que sa propre base. C'est donc Free AI Studio qui
# pose le réglage, une seule fois, à son démarrage. Le fichier témoin
# config/open-webui-regle.json dit ce qui a été posé ; le supprimer et
# redémarrer refait la pose.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=duckduckgo

# Modèle Google utilisé pour FABRIQUER une image (bouton « Image » du chat).
# La clé est celle du chat : rien de plus à saisir.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# ============================================================
# EXTENSIONS OPTIONNELLES
# ============================================================

# URL d'un serveur ComfyUI local ou distant.
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Exemple : URL d'un moteur Ollama local.
OLLAMA_BASE_URL=http://host.docker.internal:11434



# ============================================================
# SANDBOX / AGENT DE CODAGE
# ============================================================
# Générées automatiquement par install.sh / install.ps1.
SANDBOX_MANAGER_KEY=
SANDBOX_WORKER_KEY=
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_CODE_BYTES=500000
SANDBOX_MAX_OUTPUT_BYTES=200000
SANDBOX_MAX_ARTIFACT_BYTES=104857600

# Routage automatique : Modal -> Local -> Kaggle -> Colab.
# Modal n'est utilisé que si vous l'activez ET fournissez vos tokens. Cela évite
# toute consommation cloud accidentelle lors d'une installation fraîche.
MODAL_ENABLED=false
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=free-ai-studio-sandbox
# Durée maximale du code utilisateur.
MODAL_JOB_TIMEOUT_SECONDS=300
# Filet de sécurité serveur : stoppe une Sandbox Modal inactive.
MODAL_IDLE_TIMEOUT_SECONDS=60
# Temps réservé au démarrage + collecte des artefacts avant le timeout absolu.
MODAL_CLEANUP_GRACE_SECONDS=60
MODAL_CPU=1.0
MODAL_MEMORY_MB=2048
MODAL_GPU_DEFAULT=T4

# Kaggle : fallback automatisable. L'accès direct reste toujours disponible.
KAGGLE_ENABLED=false
KAGGLE_JOB_TIMEOUT_SECONDS=3600
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KEY=

# Colab : accès direct + handoff notebook. L'API officielle est bêta/allowlist.
COLAB_API_ENABLED=false

# ============================================================
# SERVICES OPTIONNELS — À IGNORER SI VOUS DÉBUTEZ
# ============================================================
HUGGINGFACE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
E2B_API_KEY=
DAYTONA_API_KEY=
FAL_KEY=
SEGMIND_API_KEY=
FIREWORKS_API_KEY=
